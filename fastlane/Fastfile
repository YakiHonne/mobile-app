def notes
  File.read(File.expand_path('../release-notes.txt', __dir__)).strip
end

def apple_key
  app_store_connect_api_key(
    key_id: ENV.fetch('ASC_KEY_ID'),
    issuer_id: ENV.fetch('ASC_ISSUER_ID'),
    key_content: ENV.fetch('ASC_KEY_CONTENT'),
    duration: 1200
  )
end

platform :android do
  lane :release do
    upload_to_play_store(
      package_name: 'com.yakihonne.yakihonne',
      json_key: ENV.fetch('PLAY_SERVICE_ACCOUNT_FILE'),
      aab: Dir[File.expand_path('../build/app/outputs/bundle/release/*.aab', __dir__)].fetch(0),
      track: ENV.fetch('RELEASE_TRACK'),
      release_status: 'completed',
      metadata_path: File.expand_path('../build/play-metadata', __dir__),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  lane :release do
    key = apple_key
    production = ENV.fetch('RELEASE_TRACK') == 'production'
    groups = production ? ENV.fetch('TESTFLIGHT_EXTERNAL_GROUPS').split(',').map(&:strip).reject(&:empty?) : []
    UI.user_error!('TESTFLIGHT_EXTERNAL_GROUPS must name at least one external group') if production && groups.empty?
    upload_to_testflight(
      api_key: key,
      app_identifier: 'com.yakihonne.appyakihonne',
      ipa: Dir[File.expand_path('../build/ios/ipa/*.ipa', __dir__)].fetch(0),
      changelog: notes,
      distribute_external: production,
      groups: groups,
      skip_waiting_for_build_processing: false
    )
    if production
      upload_to_app_store(
        api_key: key,
        app_identifier: 'com.yakihonne.appyakihonne',
        app_version: ENV.fetch('APP_VERSION'),
        build_number: ENV.fetch('APP_BUILD'),
        skip_binary_upload: true,
        skip_screenshots: true,
        release_notes: { 'default' => notes },
        submit_for_review: true,
        automatic_release: true,
        force: true,
        run_precheck_before_submit: false
      )
    end
  end
end
